
from pathlib import Path
import pandas as pd

# Search common locations in Colab and a cloned repository
candidates = [
    Path("../data/relationships.csv"),
    Path("data/relationships.csv"),
    Path("/content/data/relationships.csv"),
    Path("/content/open-source-ai-standardisation-observatory/data/relationships.csv"),
]

DATA_PATH = next((p for p in candidates if p.exists()), None)

if DATA_PATH is None:
    from google.colab import files

    print("relationships.csv was not found.")
    print("Upload the CSV from your repository's data/ folder.")
    uploaded = files.upload()

    csv_files = [name for name in uploaded if name.endswith(".csv")]
    if not csv_files:
        raise FileNotFoundError(
            "No CSV uploaded. Please upload relationships.csv."
        )

    DATA_PATH = Path(csv_files[0])

df = pd.read_csv(DATA_PATH)

required = {
    "project",
    "institution_or_process",
    "relationship_type",
    "evidence_status",
}

missing = required - set(df.columns)

if missing:
    raise ValueError(f"CSV is missing required columns: {sorted(missing)}")

print(f"CSV loaded successfully: {DATA_PATH}")
print(f"Rows: {len(df)}")
print("Columns:", list(df.columns))

if df.empty:
    print("No verified relationships yet. Add manually audited records before network analysis.")
else:
    display(df.head())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observatory Evidence Record",
  "type": "object",
  "required": [
    "project",
    "institution_or_process",
    "relationship_type",
    "evidence_status",
    "audit_notes"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "institution_or_process": {
      "type": "string"
    },
    "relationship_type": {
      "enum": [
        "formal_membership",
        "technical_contribution",
        "consultation_response",
        "documented_citation",
        "declared_alignment",
        "contextual_relevance",
        "unresolved"
      ]
    },
    "evidence_status": {
      "enum": [
        "independently_verified",
        "documented",
        "candidate",
        "gap"
      ]
    },
    "source_url": {
      "type": "string"
    },
    "source_passage": {
      "type": "string"
    },
    "access_date": {
      "type": "string",
      "format": "date"
    },
    "audit_notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_status": {
            "const": "independently_verified"
          }
        }
      },
      "then": {
        "required": [
          "source_url",
          "source_passage"
        ]
      }
    }
  ]
}